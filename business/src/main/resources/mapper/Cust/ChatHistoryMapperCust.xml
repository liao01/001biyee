<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jiawa.lyw.mapper.ChatHistoryMapperCust">
    <select id="selectByUserId" parameterType="java.lang.Long" resultType="com.jiawa.lyw.resp.ai.ChatHistoryResp">
        SELECT
            id,
            user_message,
            ai_response,
            create_time
        FROM chat_history
        WHERE user_id = #{userId}
        ORDER BY create_time ASC
    </select>

</mapper>
