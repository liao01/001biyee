<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jiawa.lyw.mapper.CommentMapperCust">

    <!-- 返回用户名、评论内容和头像 -->
    <resultMap id="CommentRespMap" type="com.jiawa.lyw.resp.CommentResp">
        <id property="id" column="id"/> <!-- 确保 id 被映射 -->
        <result property="commentContent" column="comment_content"/>
        <result property="membername" column="membername"/>
        <result property="commentTime" column="comment_time"/>
        <result property="avatar" column="avatar"/> <!-- ✅ 新增头像映射 -->
    </resultMap>

    <select id="findCommentByPostId" resultMap="CommentRespMap">
        SELECT
        c.id AS id,
        c.content AS comment_content,
        m.name AS membername,
        u.avatar AS avatar,              <!-- ✅ 新增头像 -->
        c.create_time AS comment_time
        FROM comment c
        LEFT JOIN member m ON c.user_id = m.id
        LEFT JOIN user_profile u ON c.user_id = u.user_id
        WHERE c.post_id = #{postId}
        ORDER BY c.create_time ASC
    </select>

</mapper>
