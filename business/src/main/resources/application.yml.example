# Environment variable names are defined by the repository-root .env.example.
app:
  ai:
    itinerary:
      dify:
        base-url: ${DIFY_ITINERARY_BASE_URL}
        api-key: ${DIFY_ITINERARY_API_KEY}
        user-hash-key: ${DIFY_ITINERARY_USER_HASH_KEY}
        contract-version: ${DIFY_ITINERARY_CONTRACT_VERSION:itinerary-revision/v1}
        connect-timeout: ${DIFY_ITINERARY_CONNECT_TIMEOUT:2s}
        read-timeout: ${DIFY_ITINERARY_READ_TIMEOUT:45s}
        max-response-bytes: ${DIFY_ITINERARY_MAX_RESPONSE_BYTES:262144}
        max-operations: ${DIFY_ITINERARY_MAX_OPERATIONS:80}

amap:
  key: ${AMAP_API_KEY}
